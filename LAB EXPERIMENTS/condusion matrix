# ==========================================
# Confusion Matrix - Spam Email Example
# ==========================================

# Import required library
from sklearn.metrics import confusion_matrix, accuracy_score, precision_score, recall_score, f1_score

# Actual labels
# 1 = Spam
# 0 = Not Spam

y_true = (
    [1] * 80 +     # Actually Spam (60 TP + 20 FN)
    [0] * 120      # Actually Not Spam (20 FP + 100 TN)
)

# Predicted labels
y_pred = (
    [1] * 60 +     # True Positive
    [0] * 20 +     # False Negative
    [1] * 20 +     # False Positive
    [0] * 100      # True Negative
)

# Generate Confusion Matrix
cm = confusion_matrix(y_true, y_pred)

TN, FP, FN, TP = cm.ravel()

print("========== CONFUSION MATRIX ==========\n")
print(cm)

print("\nTrue Positive (TP) :", TP)
print("True Negative (TN) :", TN)
print("False Positive (FP):", FP)
print("False Negative (FN):", FN)

# Calculate Metrics
accuracy = accuracy_score(y_true, y_pred)
precision = precision_score(y_true, y_pred)
recall = recall_score(y_true, y_pred)
specificity = TN / (TN + FP)
f1 = f1_score(y_true, y_pred)

print("\n========== PERFORMANCE METRICS ==========\n")

print("Accuracy    : {:.2f}%".format(accuracy * 100))
print("Precision   : {:.2f}%".format(precision * 100))
print("Recall      : {:.2f}%".format(recall * 100))
print("Sensitivity : {:.2f}%".format(recall * 100))
print("Specificity : {:.2f}%".format(specificity * 100))
print("F1 Score    : {:.2f}%".format(f1 * 100))

# Verification
print("\n========== VERIFICATION ==========\n")

print("Total Emails        :", TP + TN + FP + FN)
print("Correct Predictions :", TP + TN)
print("Wrong Predictions   :", FP + FN)
