# ===============================================
# Decision Tree (ID3) Algorithm using Scikit-Learn
# ===============================================

import pandas as pd
from sklearn.preprocessing import LabelEncoder
from sklearn.tree import DecisionTreeClassifier, export_text
from sklearn import tree
import matplotlib.pyplot as plt

# Read Dataset
data = pd.read_csv("PlayTennis.csv")

print("Dataset:\n")
print(data)

# Encode categorical values
le = LabelEncoder()

encoded_data = data.copy()

for column in encoded_data.columns:
    encoded_data[column] = le.fit_transform(encoded_data[column])

# Features and Target
X = encoded_data.iloc[:, :-1]
y = encoded_data.iloc[:, -1]

# Build Decision Tree using Entropy (ID3)
model = DecisionTreeClassifier(criterion="entropy", random_state=0)
model.fit(X, y)

print("\nDecision Tree Rules:\n")

feature_names = list(data.columns[:-1])

tree_rules = export_text(model, feature_names=feature_names)

print(tree_rules)

# Draw Decision Tree
plt.figure(figsize=(12,8))

tree.plot_tree(
    model,
    feature_names=feature_names,
    class_names=["No","Yes"],
    filled=True
)

plt.show()

# -----------------------------------
# Classify a New Sample
# -----------------------------------

# New Sample:
# Outlook=Sunny
# Temperature=Cool
# Humidity=High
# Wind=Strong

new_sample = pd.DataFrame({
    'Outlook':['Sunny'],
    'Temperature':['Cool'],
    'Humidity':['High'],
    'Wind':['Strong']
})

# Encode new sample using same mappings
encoded_sample = new_sample.copy()

for i, column in enumerate(new_sample.columns):
    encoder = LabelEncoder()
    encoder.fit(data[column])
    encoded_sample[column] = encoder.transform(new_sample[column])

prediction = model.predict(encoded_sample)

# Decode prediction
target_encoder = LabelEncoder()
target_encoder.fit(data['PlayTennis'])

result = target_encoder.inverse_transform(prediction)

print("\nNew Sample:")
print(new_sample)

print("\nPrediction:")
print(result[0])
